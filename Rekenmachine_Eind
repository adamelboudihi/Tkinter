import tkinter as tk

root = tk.Tk()
root.title("rekenmachine")
root.geometry("250x350")

# functies
def klik(waarde):
    ingave.insert(tk.END, waarde)

def bereken():
    try:
        resultaat = eval(ingave.get())
        ingave.delete(0, tk.END)
        ingave.insert(0, str(resultaat))
    except:
        ingave.delete(0, tk.END)
        ingave.insert(0, "Fout")

def wis():
    ingave.delete(0, tk.END)


# knoppen
ingave = tk.Entry(root)
ingave.grid(row=0, columnspan=4, padx=10, pady=10)

knop1 = tk.Button(root, text="7", command=lambda: klik("7"))
knop1.grid(row=1, column=0, ipadx=15, ipady=10, padx=5, pady=10)

